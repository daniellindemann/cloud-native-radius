#!/bin/sh

### BEGIN INIT INFO
# Provides:          cloud-provider-kind
# Required-Start:    $docker
# Required-Stop:     $docker
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Implements LoadBalancer services for KIND clusters
### END INIT INFO

NAME=cloud-provider-kind
DAEMON=/usr/local/bin/cloud-provider-kind
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log

if [ "$(id -u)" -ne 0 ]; then
  echo "$NAME commands can only be run by root; use: sudo service $NAME <command>"
  exit 4
fi

case "$1" in
  start)
    echo "Starting $NAME..."
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
      --startas /bin/sh -- -c "exec $DAEMON >>$LOGFILE 2>&1"
    ;;
  stop)
    echo "Stopping $NAME..."
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry TERM/5/KILL/5
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "$NAME is running (pid $(cat "$PIDFILE"))"
      exit 0
    else
      echo "$NAME is not running"
      exit 3
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/$NAME {start|stop|restart|status}"
    exit 1
    ;;
esac
